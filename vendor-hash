#!/usr/bin/env bash
set -euo pipefail

if [[ $# != 2 ]]; then
    echo "usage: vendor-hash <nix file holding vendorHash> <flake attribute of the vendor derivation>" >&2
    exit 2
fi
file=$1
attr=$2
fake=sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
pattern='vendorHash = "sha256-[A-Za-z0-9+/=]*";'
count=$(grep -c "$pattern" "$file" || [[ $? == 1 ]])
if [[ "$count" != 1 ]]; then
    echo "vendor-hash: expected one vendorHash in $file, found $count" >&2
    exit 1
fi
original=$(mktemp)
log=$(mktemp)
written=
trap '[[ -n "$written" ]] || cp "$original" "$file"; rm -f "$original" "$log" "$file.tmp"' EXIT
cp "$file" "$original"
sed "s|$pattern|vendorHash = \"$fake\";|" "$original" > "$file.tmp"
mv "$file.tmp" "$file"
if nix build --no-link "$attr" > "$log" 2>&1; then
    echo "vendor-hash: $attr built with the fake hash $fake, so it is not fixed-output on $file's vendorHash" >&2
    exit 1
fi
got=$(sed -n 's/^ *got: *\(sha256-[A-Za-z0-9+/=]*\)$/\1/p' "$log")
if [[ ! "$got" =~ ^sha256-[A-Za-z0-9+/]{43}=$ ]]; then
    cat "$log" >&2
    echo "vendor-hash: $attr failed without reporting its hash" >&2
    exit 1
fi
sed "s|$pattern|vendorHash = \"$got\";|" "$original" > "$file.tmp"
mv "$file.tmp" "$file"
written=1
echo "vendorHash = $got"
